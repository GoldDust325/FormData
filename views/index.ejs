<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel='stylesheet' href='/stylesheets/style.css' />
</head>
<body>
<h1><%= title %></h1>
<p>Welcome to <%= title %>.   Let's test reading get+post data</p>

<br/><br/>
<b>New Customer Form </b> to test POST request and reading data using URI  /readNameAndRespond
<br/>
<form action="/readCustomerInfoAndRespond" method="post">

  Name: <input type="text" name="name"> </input>
  <br/>
  Email: <input type="text" name="email"> </input>
  <br/>
  <input type="submit" value="Go"/>
</form>

<br><br><br>
<hr>

<b>Form to test GET request</b> and reading the data using URI /readNameAndRespond
<br/>
<form action="/readNameAndRespond" method="get">

  Name: <input type="text" name="name"> </input>
  <br/>
  <input type="submit" value="Go"/>
</form>
<br><br><br>
<hr>
<b>Form to test POST request</b> and reading data using URI  /readNameAndRespond
<br/>
<form action="/readNameAndRespond" method="post">

  Name: <input type="text" name="name"> </input>
  <br/>
  <input type="submit" value="Go"/>
</form>



<hr>

<h2>REST API Customer Form</h2>
<p>Submit customer information using JavaScript fetch().</p>

Name: <input type="text" id="name">
<br><br>

Email: <input type="email" id="email">
<br><br>

<button type="button" id="submitBtn">Submit with REST API</button>

<p id="result"></p>

<script>
document.getElementById("submitBtn").addEventListener("click", async () => {

    // Send customer information to the Express REST API
    const response = await fetch("/api/customer", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({
            name: document.getElementById("name").value,
            email: document.getElementById("email").value
        })
    });

    // Read the JSON response from Express
    const data = await response.json();

    // Display the response without reloading the page
    document.getElementById("result").innerHTML =
        data.message + "<br>" + data.email;
});
</script>

</body>
</html>
